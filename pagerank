import pandas as pd
import networkx as nx
import matplotlib.pyplot as plt
df = pd.read_excel("/kaggle/input/social-media-engagement-report/social_media_engagement_data.xlsx")
df.columns = df.columns.str.strip().str.lower()
graph_df = df[['platform', 'post type']].dropna()
graph_df.columns = ['source', 'target']
G = nx.from_pandas_edgelist(graph_df, 'source', 'target')
pr = nx.pagerank(G)
print("PageRank Scores:")
print(pr)
nx.draw(G, with_labels=True)
plt.title("Page Ranking Graph")
plt.show()





