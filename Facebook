import kagglehub
import pandas as pd
import matplotlib.pyplot as plt
import os
path = kagglehub.dataset_download("aliredaelblgihy/social-media-engagement-report")
print("Path to dataset files:", path)
print("Files in dataset folder:", os.listdir(path))
file_path = os.path.join(path, "social_media_engagement_data.xlsx")
df = pd.read_excel(file_path)
print("\nFirst 5 Rows of Dataset:")
print(df.head())
print("\nColumns in Dataset:")
print(df.columns)
df.columns = df.columns.str.strip().str.lower()
df['engagement'] = df['likes'] + df['comments'] + df['shares']
platform_engagement = df.groupby('platform')['engagement'].mean()
print("\nAverage Engagement by Platform:")
print(platform_engagement)
platform_engagement.plot(kind='bar')
plt.title("Average Social Media Engagement by Platform")
plt.xlabel("Platform")
plt.ylabel("Average Engagement")
plt.xticks(rotation=45)
plt.show()




#own dataset
import pandas as pd
import matplotlib.pyplot as plt
data = {
    'brand': ['Nike', 'Adidas', 'Puma', 'Nike', 'Adidas'],
    'likes': [500, 450, 300, 550, 470],
    'comments': [40, 35, 20, 50, 38],
    'shares': [25, 20, 15, 30, 22]
}
df = pd.DataFrame(data)
df['engagement'] = df['likes'] + df['comments'] + df['shares']
print(df)
df.groupby('brand')['engagement'].mean().plot(kind='bar')
plt.title("Brand Engagement on Facebook")
plt.ylabel("Engagement")
plt.show()







