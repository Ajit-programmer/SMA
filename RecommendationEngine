#dataset
import pandas as pd
df = pd.read_excel("/kaggle/input/social-media-engagement-report/social_media_engagement_data.xlsx")
df.columns = df.columns.str.strip().str.lower()
df['rating'] = df['likes'] + df['comments'] + df['shares']
recommend = df.groupby('platform')['rating'].mean().sort_values(ascending=False)
print("Top Recommended Places:")
print(recommend.head())





#owndataset
import pandas as pd
data = {
    'user_id': [101, 102, 103, 104, 105, 106],
    'place': ['Cafe ABC', 'Park View', 'Cafe ABC', 'Mall Plaza', 'Park View', 'Cafe ABC'],
    'rating': [4.5, 4.0, 5.0, 3.8, 4.2, 4.8]
}
df = pd.DataFrame(data)
recommend = df.groupby('place')['rating'].mean().sort_values(ascending=False)
print("Top Recommended Places:")
print(recommend.head())





Theory

A recommendation system suggests useful items to users based on ratings and preferences.
In Foursquare, places can be recommended based on user reviews and ratings.

Higher average rating means better recommendation.

